# ── AI Spatial Video Engine Series — Environment Variables ────────────────────
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to git.

# ── Gemini ────────────────────────────────────────────────────────────────────
# Required for all engines.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Grok / xAI (for video generation, Engines I–VII) ─────────────────────────
# Get yours at: https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# ── ComfyUI (Engines VI–XI — neural skinning) ────────────────────────────────
# Default: localhost. Change if running ComfyUI on a remote machine.
COMFYUI_BASE_URL=http://127.0.0.1:8188

# ── Automatic1111 / sd-webui (alternative to ComfyUI) ────────────────────────
A1111_BASE_URL=http://127.0.0.1:7860

# ── Blender executable path ───────────────────────────────────────────────────
# macOS default shown. Adjust for your OS:
#   Linux:   /usr/bin/blender
#   Windows: C:\Program Files\Blender Foundation\Blender 4.3\blender.exe
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender

# ── Neo4j (optional, Engines VIII–IX) ────────────────────────────────────────
# Only needed if use_in_memory_graph=False in ArchonConfig / VertexConfig.
NEO4J_BOLT_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
